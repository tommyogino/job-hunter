# Copy to .env for local runs (never commit .env).

# --- Telegram (obrigatório) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# --- Filtros de busca ---
# Termos enviados como "search" para a API da Remotive (separados por vírgula).
JOB_SEARCH_TERMS=python,backend
# Palavras-chave para filtrar a RemoteOK localmente (a Remotive já filtra no servidor).
# Se vazio, cai para JOB_SEARCH_TERMS. Deixe em branco para não filtrar.
JOB_KEYWORDS=python,django,fastapi

# Localizações elegíveis para home office (proxy de idioma EN/PT), aplicado às
# duas fontes. Casa como substring, case-insensitive, contra o local da vaga.
# Deixe em branco para não filtrar por localização. Padrão inclui regiões
# lusófonas e anglófonas/abertas (worldwide, americas, brazil, usa, uk, etc.).
REMOTE_LOCATIONS=worldwide,anywhere,americas,north america,south america,latam,latin america,brazil,brasil,portugal,usa,united states,canada,uk,united kingdom,ireland,australia,new zealand,europe,emea
# Manter vagas com local vazio/desconhecido (comum na RemoteOK)? Padrão: sim.
ALLOW_UNKNOWN_LOCATION=true

# Só entry-level / estágio? As APIs não têm campo de senioridade, então o filtro
# usa palavras-chave no título + tags + job_type. Coloque false para não filtrar.
ENTRY_LEVEL_ONLY=true
# Sinais de nível júnior/estágio (EN+PT). Vazio = não filtra por nível.
LEVEL_KEYWORDS=intern,internship,junior,júnior,jr,entry level,entry-level,graduate,trainee,apprentice,new grad,early career,estagio,estágio,estagiario,estagiário,jovem aprendiz,aprendiz
# Sinais que vetam a vaga mesmo com match positivo.
LEVEL_EXCLUDE=senior,sênior,principal,staff engineer

# --- Comportamento ---
# Caminho do banco SQLite.
DATABASE_PATH=data/jobs.db
# Máximo de notificações por execução (evita flood/rate limit do Telegram).
MAX_NOTIFICATIONS_PER_RUN=20
# Na primeira execução (banco vazio), notificar tudo? Padrão: não (só semeia o banco).
NOTIFY_ON_FIRST_RUN=false
# Timeout de requisições HTTP (segundos).
REQUEST_TIMEOUT=30
# User-Agent (a RemoteOK bloqueia UA genérico/vazio).
USER_AGENT=job-hunter/1.0 (+https://github.com/tommyogino/job-hunter)
